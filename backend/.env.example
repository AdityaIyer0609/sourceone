# PostgreSQL connection (SQLAlchemy + psycopg2).
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23, % -> %25).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sourceone

# Set to true to log SQL statements.
DATABASE_ECHO=false

# Buyers and suppliers see products and their own orders. Supplier names and negotiations stay available to admins.
HIDE_SUPPLIERS=false

# Signs login tokens. Change this outside local development.
AUTH_SECRET=sourceone-dev-auth-secret
AUTH_TOKEN_TTL_SECONDS=43200

# Pricing configuration (defaults shown). Source staleness days live on rate_sources.
BUSINESS_UTC_OFFSET_MINUTES=330
PRICING_HISTORY_MIN_POINTS=2
PRICING_VOLATILITY_MIN_POINTS=5
PRICING_NEGOTIATION_WINDOW_DAYS=30

# ERP (SQL Server), read-only. Disabled unless ERP_ENABLED=true and every connection value is set.
# Use a dedicated login with SELECT-only rights on DomesticPrice1, DomesticGrade and CompanyMaster.
# Requires the optional driver package: pip install -r requirements-erp.txt
ERP_ENABLED=false
ERP_HOST=
ERP_PORT=1433
ERP_USERNAME=
ERP_PASSWORD=
ERP_ODBC_DRIVER=ODBC Driver 18 for SQL Server
ERP_ENCRYPT=true
ERP_TRUST_SERVER_CERTIFICATE=false
ERP_LOGIN_TIMEOUT_SECONDS=15
ERP_QUERY_TIMEOUT_SECONDS=60
ERP_PRICE_DATABASE=MaterialProcessing
ERP_CUSTOMER_DATABASE=Despatch
ERP_RATE_SOURCE_CODE=ERP-DOMESTICPRICE1

# Geoapify road distance, used only when no saved freight lane matches. Leave empty to keep freight on request.
# Do not commit a real key.
GEOAPIFY_API_KEY=
