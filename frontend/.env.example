# Base path the browser uses for API calls. Keep /api/v1 to go through the Vite dev proxy.
VITE_API_BASE_URL=/api/v1

# FastAPI server the Vite dev proxy forwards /api requests to (dev server only, not exposed to the browser).
API_PROXY_TARGET=http://127.0.0.1:8000

# LOCAL DEMO ONLY. Sends X-Demo-User from the dev server (never in production builds); the backend
# must also have DEMO_AUTH_ENABLED=true. Not an authentication mechanism.
# Switch users with ?demoUser=asha|ravi|meera|buyer|supplier or sourceoneDemo.use('ravi') in the console.
VITE_DEMO_AUTH=false
VITE_DEMO_USER=buyer
